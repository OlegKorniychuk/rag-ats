DATABASE_URL=postgres://rag_ats:rag_ats@localhost:5432/rag_ats
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
PORT=3000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# How applications are scored: full_text (whole CV in one prompt) or rag (per criterion,
# from the most similar CV/GitHub chunks). Applies to new scores only.
SCORING_MODE=full_text
# Optional: raises the GitHub API rate limit from 60 to 5000 requests/h.
GITHUB_TOKEN=
JOBS_POLL_INTERVAL_SECONDS=2
